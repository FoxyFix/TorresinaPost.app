# Copia in Netlify > Site configuration > Environment variables
# (mai nel repository: .env è in .gitignore)

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Tag che fanno scattare l'import (Pagina Facebook e Telegram), separati da virgola
TAG_IMPORT=#torresina,#torresinaeventi

# Meta (Instagram + Pagina Facebook)
META_APP_SECRET=
META_VERIFY_TOKEN=una-parola-segreta-a-scelta
META_PAGE_TOKEN=
META_GRAPH_VERSION=v23.0
IG_USER_ID=
FB_PAGE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TorresinaBot
TELEGRAM_SECRET=un-altra-parola-segreta
TELEGRAM_CHAT_IDS=-1001234567890
